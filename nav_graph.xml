<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/navigation_home">

    <fragment
        android:id="@+id/navigation_home"
        android:name="com.example.mobilityapp.ui.home.HomeFragment"
        android:label="@string/title_home" />

    <fragment
        android:id="@+id/navigation_schedule"
        android:name="com.example.mobilityapp.ui.schedule.ScheduleFragment"
        android:label="@string/title_schedule">
        <action
            android:id="@+id/action_scheduleFragment_to_scheduleRideFragment"
            app:destination="@id/scheduleRideFragment" />
        <action
            android:id="@+id/action_scheduleFragment_to_rideDetailsFragment"
            app:destination="@id/rideDetailsFragment" />
    </fragment>

    <fragment
        android:id="@+id/navigation_profile"
        android:name="com.example.mobilityapp.ui.profile.ProfileFragment"
        android:label="@string/title_profile" />

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.worklet.mobility.ui.user.LoginFragment"
        android:label="Login"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_loginFragment_to_registerFragment"
            app:destination="@id/registerFragment" />
        <action
            android:id="@+id/action_loginFragment_to_mainFragment"
            app:destination="@id/mainFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.worklet.mobility.ui.user.RegisterFragment"
        android:label="Register"
        tools:layout="@layout/fragment_register">
        <action
            android:id="@+id/action_registerFragment_to_loginFragment"
            app:destination="@id/loginFragment" />
    </fragment>

    <fragment
        android:id="@+id/mainFragment"
        android:name="com.worklet.mobility.ui.main.MainFragment"
        android:label="Main"
        tools:layout="@layout/fragment_main">
        <action
            android:id="@+id/action_main_to_user"
            app:destination="@id/userActivity" />
        <action
            android:id="@+id/action_main_to_journey"
            app:destination="@id/journeyFragment" />
    </fragment>

    <fragment
        android:id="@+id/journeyFragment"
        android:name="com.worklet.mobility.ui.journey.JourneyFragment"
        android:label="Journey"
        tools:layout="@layout/fragment_journey" />

    <activity
        android:id="@+id/userActivity"
        android:name="com.worklet.mobility.ui.user.UserActivity"
        android:label="User Profile" />

    <fragment
        android:id="@+id/scheduleRideFragment"
        android:name="com.example.mobilityapp.ui.schedule.ScheduleRideFragment"
        android:label="@string/schedule_ride" />

    <fragment
        android:id="@+id/rideDetailsFragment"
        android:name="com.example.mobilityapp.ui.schedule.RideDetailsFragment"
        android:label="@string/ride_details">
        <argument
            android:name="rideId"
            app:argType="string" />
    </fragment>

</navigation> 